{
  "name": "andreamnc-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run collect:now; astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "bddgen && playwright test",
    "check": "astro check",
    "collect:now": "rolldown scripts/collect-now.ts --platform node --format esm --file node_modules/.cache/collect-now.mjs --log-level warn && node node_modules/.cache/collect-now.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "astro": "^7.4.4",
    "fast-xml-parser": "^5.11.2",
    "mimetext": "^3.0.28",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "playwright-bdd": "^9.2.1",
    "rolldown": "^1.2.16",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
