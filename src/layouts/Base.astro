---
import "@fontsource/jost/400.css";
import "@fontsource/jost/500.css";
import "../styles/base.css";
import { themeCss } from "../design/css";
import { earlyScript } from "../adapters/daylight/inline";
import { structuredData } from "../adapters/seo/structured-data";
import { SITE } from "../content/site";
import { CHANNELS, CONTACT_ADDRESS } from "../content/channels";

interface Props { title: string }
const { title } = Astro.props;
const early = await earlyScript();
const graph = JSON.stringify(structuredData(SITE, CHANNELS, CONTACT_ADDRESS));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={SITE.summary} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={SITE.url} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:title" content={SITE.name} />
    <meta property="og:description" content={SITE.summary} />
    <meta property="og:image" content={SITE.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The ASCII mountain range on andreamnc.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE.name} />
    <meta name="twitter:description" content={SITE.summary} />
    <meta name="twitter:image" content={SITE.image} />
    <script type="application/ld+json" set:html={graph}></script>
    <link rel="alternate" type="application/rss+xml" title="André Amnc" href="/rss.xml" />
    <style is:inline set:html={themeCss()}></style>
    <script is:inline set:html={early}></script>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
