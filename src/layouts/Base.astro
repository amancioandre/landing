---
import "@fontsource/jost/400.css";
import "@fontsource/jost/500.css";
import "../styles/base.css";
import { themeCss } from "../design/css";
import { earlyScript } from "../adapters/daylight/inline";
import { structuredData } from "../adapters/seo/structured-data";
import { SITE } from "../content/site";
import { CHANNELS, CONTACT_ADDRESS } from "../content/channels";
import { UMAMI } from "../content/analytics";
import type { Copy } from "../content/copy/copy";
import { letterWordsIn } from "../content/prompts";
import { WORDS_ID } from "../adapters/letter/words";
import { alternates, pathFor, type Language } from "../domain/languages/languages";

interface Props { title: string; language: Language; copy: Copy }
const { title, language, copy } = Astro.props;
const early = await earlyScript();
const graph = JSON.stringify(structuredData(SITE, CHANNELS, CONTACT_ADDRESS));
const here = new URL(pathFor(language), SITE.url).href;
const words = JSON.stringify(letterWordsIn(copy));
---
<!doctype html>
<html lang={language.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={copy.site.summary} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={here} />
    {alternates(SITE.url).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={here} />
    <meta property="og:locale" content={language.tag.replace("-", "_")} />
    <meta property="og:title" content={SITE.name} />
    <meta property="og:description" content={copy.site.summary} />
    <meta property="og:image" content={SITE.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.site.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE.name} />
    <meta name="twitter:description" content={copy.site.summary} />
    <meta name="twitter:image" content={SITE.image} />
    <script type="application/ld+json" set:html={graph}></script>
    <link rel="alternate" type="application/rss+xml" title="André Amnc" href="/rss.xml" />
    <script is:inline defer src={UMAMI.script} data-website-id={UMAMI.websiteId} data-domains={UMAMI.domain}></script>
    <style is:inline set:html={themeCss()}></style>
    <script is:inline set:html={early}></script>
    <script type="application/json" id={WORDS_ID} set:html={words}></script>
  </head>
  <body id="top">
    <slot />
  </body>
</html>
