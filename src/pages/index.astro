---
import Base from "../layouts/Base.astro";
import Bar from "../ui/Bar.astro";
import Section from "../ui/Section.astro";
import Footer from "../ui/Footer.astro";
import Range from "../ui/Range.astro";
import WriteLetter from "../ui/WriteLetter.astro";
import LatestList from "../ui/LatestList.astro";
import Carousel from "../ui/Carousel.astro";
---
<Base title="André Amnc">
  <Bar />
  <Range />
  <main>
    <Section id="latest" number="01" label="Latest" draft><LatestList /></Section>
    <Section id="interests" number="02" label="Interests" draft><Carousel /></Section>
    <Section id="write" number="03" label="write to me"><WriteLetter /></Section>
  </main>
  <Footer />
</Base>
