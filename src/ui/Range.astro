---
// The first screen (ADR 0002): the ASCII range, five waypoints on the trail, the index in the sky (ADR 0011),
// and one card per interest held by a red tether. Layout and drawing live in adapters/range.
import Icon from "./Icon.astro";
import type { Copy } from "../content/copy/copy";
import type { InterestStop } from "../content/interests";
import { CENTRE, objectPosition } from "../domain/interests/framing";
import { OFFERS } from "../content/copy";
import { OFFERS_ID } from "../adapters/languages/offer";
interface Props { copy: Copy; stops: readonly InterestStop[] }
const { copy, stops } = Astro.props;
const n = (i: number) => String(i + 1).padStart(2, "0");
---
<section class="range" data-range aria-label={copy.range.label}>
  <canvas aria-hidden="true"></canvas>
  {stops.map((stop, i) => (
    <button class="stop" type="button" data-stop data-i={i} aria-pressed="false" aria-label={`${n(i)} ${stop.label}`}>{n(i)}</button>
  ))}
  <nav class="index" aria-label={copy.range.index}>
    {stops.map((stop, i) => (
      <button type="button" data-entry data-i={i} aria-pressed="false"><span class="n">{n(i)}</span>{stop.label}</button>
    ))}
  </nav>
  <a class="offer" data-offer data-choose-language hidden><span class="n" data-code></span><span data-words></span></a>
  <script type="application/json" id={OFFERS_ID} set:html={JSON.stringify(OFFERS)}></script>
  <div class="tether" data-tether hidden aria-hidden="true"></div>
  <div class="card" data-card hidden aria-live="polite">
    {stops.map((stop) => (
      <article data-card-for={stop.name} hidden>
        {stop.photo ? <img src={stop.photo.src} alt={stop.photo.alt} loading="lazy" style={`object-position: ${objectPosition(stop.photo.focus ?? CENTRE)}`} /> : <div class="empty">{copy.range.photoToCome}</div>}
        <h3>{stop.label}</h3>
        <p class:list={["say", { placeholder: !stop.line }]}>{stop.line ?? copy.range.lineToCome}</p>
        <ul>
          {stop.links.map((link) => (
            <li><a href={link.url} target="_blank" rel="noopener">{link.icon && <Icon name={link.icon} />}{link.label}<Icon name="out" size={13} class="out" /></a></li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<script>
  import { mountRange } from "../adapters/range/range-view";
  import { STOPS } from "../content/interests";
  mountRange(document.querySelector<HTMLElement>("[data-range]")!, STOPS);
  import { mountOffer } from "../adapters/languages/offer";
  mountOffer(document.querySelector<HTMLAnchorElement>("[data-offer]")!);
</script>

<style>
  .range { position: relative; height: 100svh; min-height: 600px; overflow: hidden; }
  @media (max-height: 599px) { .range { min-height: 0; } }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stop, .index, .tether, .offer { opacity: calc(1 - var(--leave, 0)); }
  .range:global([data-leaving]) :is(.stop, .index, .card, .offer) { pointer-events: none; }
  /* The offer (canvas row 11, C): a mark in the sky opposite the index, its code in red like a waypoint's number. */
  .offer {
    position: absolute; z-index: 2; right: var(--gutter); top: calc(84px + 3svh); display: flex; align-items: baseline; gap: 8px;
    text-decoration: none; font: 400 14px/1 var(--sans); letter-spacing: .06em; color: var(--ink-2); padding: 4px 0;
    background: var(--paper); box-shadow: 0 0 0 3px var(--paper);
  }
  .offer[hidden] { display: none; }
  .offer .n { font: 500 11px var(--mono); color: var(--signal); }
  .offer:hover, .offer:focus-visible { color: var(--ink); }
  .stop {
    position: absolute; z-index: 2; transform: translate(-50%, calc(-100% - 12px)); border: 0; padding: 4px 6px; cursor: pointer;
    font: 500 12px/1 var(--mono); color: var(--signal); background: var(--paper); box-shadow: 0 0 0 3px var(--paper);
  }
  .stop[aria-pressed="true"] { font-weight: 700; }
  /* A finger-sized target around the small number, with nothing drawn. */
  .stop::before { content: ""; position: absolute; inset: -12px -9px; }
  /* By day the fog can leave a number hanging in the air: a short stem sets it down on the ground beneath. */
  :global([data-theme="day"]) .stop::after { content: ""; position: absolute; left: calc(50% - .75px); top: 100%; width: 1.5px; height: 12px; background: var(--ink-2); }
  .index { position: absolute; z-index: 2; left: var(--gutter); top: calc(84px + 3svh); display: grid; gap: 12px; }
  .index button {
    width: fit-content; border: 0; padding: 4px 0; cursor: pointer; text-align: left; color: var(--ink-2);
    font: 400 16px/1 var(--sans); letter-spacing: .06em; background: var(--paper); box-shadow: 0 0 0 3px var(--paper);
  }
  .index .n { font: 11px var(--mono); color: var(--mute); margin-right: 14px; }
  .index button[aria-pressed="true"] { color: var(--ink); font-weight: 500; }
  /* The tether draws up from the waypoint to the card, every time a card opens. */
  .tether { position: absolute; z-index: 4; width: 1.5px; background: var(--signal); display: none;
    transform-origin: bottom; transform: scaleY(0); transition: transform .5s ease-out; }
  .tether:global(.drawn) { transform: scaleY(1); }
  .card { opacity: 0; transform: translateY(6px); transition: opacity .45s ease-out, transform .45s ease-out; }
  .card:global(.open) { opacity: calc(1 - var(--leave, 0)); transform: none; }
  .card img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1); }
  .empty { aspect-ratio: 4 / 3; display: grid; place-items: center; border: 1px dashed var(--mark); font: 12px var(--mono); color: var(--mute); }
  .card h3 { font-size: 18px; line-height: 1.3; font-weight: 500; }
  .card .say { font: italic 400 14px/1.4 var(--sans); color: var(--mute); }
  .card ul { list-style: none; padding: 0; margin-top: 6px; display: grid; gap: 6px; font-size: 14px; color: var(--ink-2); }
  .card li a { display: inline-flex; align-items: center; gap: 8px; }
  .card :global(.out) { color: var(--signal); }
  .card h3, .card .say, .card li { width: fit-content; background: var(--paper); box-shadow: 0 0 0 3px var(--paper); }
  /* The sheet: always on phones, and wherever a card can't hang clear of the index and the other waypoints. */
  .card:global(.sheet) {
    position: fixed; left: 0 !important; right: 0; top: auto !important; bottom: 0; z-index: 5; width: auto;
    padding: 16px 16px 22px; background: var(--paper); border-top: 1px solid var(--signal); text-align: left;
  }
  .card:global(.sheet) article { display: grid; grid-template-columns: 112px 1fr; column-gap: 14px; align-items: start; }
  .card:global(.sheet) article :is(img, .empty) { grid-row: 1 / span 3; }
  .card:global(.sheet) h3 { margin-top: 0; }
  .card:global(.sheet) :is(h3, .say) { margin-left: 0; }
  .card:global(.sheet) ul { justify-items: start; }
  @media (min-width: 700px) {
    .index { top: 22%; left: auto; right: clamp(24px, 3vw, 56px); justify-items: end; }
    .offer { top: 22%; right: auto; left: clamp(24px, 3vw, 56px); gap: 10px; font-size: 15px; }
    .offer .n { font-size: 12px; }
    .index button { font-size: 15px; padding: 0; text-align: right; }
    .card { position: absolute; z-index: 3; width: 240px; padding: 0 0 6px 14px; }
    .card h3 { margin-top: 10px; }
    .card:global(.flip) { text-align: right; padding: 0 14px 6px 0; }
    .card:global(.flip) ul { justify-items: end; }
    .card:global(.flip) :is(h3, .say) { margin-left: auto; }
    .tether { display: block; }
    .tether[hidden] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .card, .tether { transition: none; } }
</style>
