---
// The interests, read sideways (canvas row 3): one card in focus; the rest wait with their photo drawn in glyphs.
import Icon from "./Icon.astro";
import type { Copy } from "../content/copy/copy";
import type { InterestStop } from "../content/interests";
import { CENTRE, objectPosition } from "../domain/interests/framing";
import { fill } from "../domain/languages/fill";
interface Props { copy: Copy; stops: readonly InterestStop[] }
const { copy, stops } = Astro.props;
const START = 1;   // as on the canvas: the second card in focus, so the first peeks in from the left
const n = (i: number) => String(i + 1).padStart(2, "0");
---
<div class="carousel" data-carousel>
  <div class="head">
    <nav class="choose" aria-label={copy.carousel.all}>
      {stops.map((stop, i) => (
        <button type="button" data-choose aria-pressed="false" aria-label={stop.label}><span class="n">{n(i)}</span><span class="name">{stop.label}</span></button>
      ))}
    </nav>
    <div class="arrows">
      <button type="button" data-prev aria-label={copy.carousel.previous}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
      <button type="button" data-next aria-label={copy.carousel.next}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
    </div>
  </div>

  <div class="viewport">
    <div class="track" data-track tabindex="0" role="group" aria-roledescription={copy.carousel.carouselRole} aria-label={copy.carousel.strip} style={`--focus: ${START}`}>
      {stops.map((stop, i) => (
        <article class="slide" id={`interest-${stop.name.toLowerCase()}`} data-slide={stop.name} aria-roledescription={copy.carousel.slideRole} aria-label={fill(copy.carousel.slide, { n: i + 1, total: stops.length, name: stop.label })}>
          <button class="figure" type="button" data-pick aria-label={fill(copy.carousel.show, { name: stop.label })} tabindex="-1">
            {stop.photo ? (
              <>
                <canvas aria-hidden="true"></canvas>
                <img src={stop.photo.src} alt={stop.photo.alt} loading="lazy" data-focus={(stop.photo.focus ?? CENTRE).join(",")} style={`object-position: ${objectPosition(stop.photo.focus ?? CENTRE)}`} />
              </>
            ) : <span class="empty">{copy.range.photoToCome}</span>}
          </button>
          <div class="body" data-body>
            <div class="title"><span class="n">{n(i)}</span><h3>{stop.label}</h3></div>
            <p class:list={["line", { placeholder: !stop.line }]}>{stop.line ?? copy.range.lineToCome}</p>
            <ul class="links">
              {stop.links.map((link) => (
                <li><a href={link.url} target="_blank" rel="noopener">{link.icon && <Icon name={link.icon} />}{link.label}<Icon name="out" size={13} class="out" /></a></li>
              ))}
            </ul>
            {stop.piece && <p class="piece">{stop.piece}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  import { mountCarousel } from "../adapters/interests/carousel-view";
  const root = document.querySelector<HTMLElement>("[data-carousel]")!;
  mountCarousel(root, Number(getComputedStyle(root.querySelector("[data-track]")!).getPropertyValue("--focus")) || 0);
</script>

<style>
  .carousel { --card: 280px; --gap: 16px; display: flex; flex-direction: column; gap: 20px; }
  .head { display: flex; align-items: center; gap: 16px; }
  .choose { display: flex; flex-wrap: wrap; gap: 4px 0; }
  .choose button { display: flex; gap: 8px; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; background: none; border: 0; padding: 0; cursor: pointer; font-size: 15px; font-weight: 500; letter-spacing: .04em; color: var(--mute); }
  .choose .n { font: 500 12px var(--mono); }
  .choose .name { display: none; }
  .choose button[aria-pressed="true"] { color: var(--ink); }
  .choose button[aria-pressed="true"] .n { color: var(--signal); }
  .arrows { margin-left: auto; display: flex; gap: 8px; }
  .arrows button { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 1px solid var(--mark); border-radius: 50%; cursor: pointer; color: var(--ink); }
  /* The strip runs the screen's full width: the card in focus sits at --lead (the column's edge on wide screens,
     centred on phones), the ones it passed wait in the margin to its left, the next ones to its right. */
  .viewport { margin-left: calc(-1 * var(--bleed, 0px)); width: calc(100% + 2 * var(--bleed, 0px)); overflow: hidden; }
  .track { display: flex; gap: var(--gap); outline-offset: 8px; touch-action: pan-y; padding-left: var(--lead, 0px);
    transform: translateX(calc(var(--focus) * (var(--card) + var(--gap)) * -1)); transition: transform .7s var(--ease); }
  .slide { flex: none; width: var(--card); display: flex; flex-direction: column; gap: 14px; }
  .figure { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink); }
  .figure canvas, .figure img { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The glyphs lie beneath; the photo above them shows only inside the focus slot (the frontier, set in the view). */
  .figure img { object-fit: cover; filter: grayscale(1); }
  .slide:global([data-focus]) .figure { cursor: default; }
  .empty { position: absolute; inset: 0; display: grid; place-items: center; border: 1px dashed var(--mark); font: 12px var(--mono); color: var(--mute); }
  .body { display: flex; flex-direction: column; gap: 12px; opacity: .32; transition: opacity .7s ease; }
  .slide:global([data-focus]) .body { opacity: 1; }
  .title { display: flex; gap: 12px; align-items: baseline; }
  .title .n { font: 500 12px var(--mono); color: var(--signal); }
  h3 { font-size: 28px; line-height: 34px; font-weight: 500; letter-spacing: -.01em; }
  .line { font-style: italic; }
  .links { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 500; }
  .links a { display: inline-flex; align-items: center; gap: 10px; }
  .links :global(.out) { color: var(--signal); }
  .piece { margin-top: 8px; }
  @media (min-width: 700px) {
    .carousel { --card: 360px; --gap: 56px; }
    .choose { gap: 4px 20px; }
    .choose .name { display: inline; }
    .choose button { align-items: baseline; padding-top: 13px; justify-content: start; min-width: 0; }
    h3 { font-size: 32px; line-height: 38px; }
  }
  @media (prefers-reduced-motion: reduce) { .track, .body { transition: none; } }
</style>
