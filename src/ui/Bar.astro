---
// The bar: the name, the letter at its centre (it types Andre's questions), the way around.
import Icon from "./Icon.astro";
import { STOPS } from "../content/interests";
import { CHANNELS, CONTACT_ADDRESS } from "../content/channels";
const SECTIONS = [["latest", "Latest"], ["interests", "Interests"]] as const;   // labels are Claude's drafts
const n = (i: number) => String(i + 1).padStart(2, "0");
const slug = (label: string) => `interest-${label.toLowerCase()}`;
---
<header class="bar">
  <h1 class="mark"><a href="#top">André Amnc</a></h1>

  <div class="letter" data-bar-letter>
    <button class="ask" type="button" data-ask aria-expanded="false" aria-controls="bar-panel"></button>
    <div class="panel" id="bar-panel" data-panel hidden>
      <p class="said" data-said hidden></p>
      <label class="sr-only" for="bar-note">Your message</label>
      <textarea id="bar-note" rows="2"></textarea>
      <label class="sr-only" for="bar-from">Your email</label>
      <input id="bar-from" type="email" autocomplete="email" placeholder="Your email, so I can reply" hidden />
      <div class="row">
        <button class="key" type="button" data-key><Icon name="enter" size={13} /><span>enter</span></button>
        <button class="quiet" type="button" data-back hidden>Edit message</button>
        <button class="quiet" type="button" data-again>Another question</button>
      </div>
      <p class="status" role="status"></p>
    </div>
  </div>

  <nav class="sections" aria-label="Sections">
    {SECTIONS.map(([id, label]) => <a href={`#${id}`}><span class="draft">{label}</span></a>)}
  </nav>

  <button class="menu-button" type="button" data-menu-button aria-label="Menu" aria-expanded="false" aria-controls="menu">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 9h18M3 15h18" /></svg>
  </button>
  <nav class="menu" id="menu" data-menu aria-label="Menu" hidden>
    <ol class="menu-sections">
      <li><a href="#latest"><span class="n">01</span><span class="name draft">Latest</span></a></li>
      <li>
        <a href="#interests"><span class="n">02</span><span class="name draft">Interests</span></a>
        <ol class="menu-interests" aria-label="Interests">
          {STOPS.map((stop, i) => <li><a href={`#${slug(stop.label)}`}><span class="n">{n(i)}</span>{stop.label}</a></li>)}
        </ol>
      </li>
      <li><a href="#write" class="act"><span class="n">03</span><span class="name">write to me</span></a></li>
    </ol>
    <div class="menu-foot">
      <div class="menu-channels">
        {CHANNELS.map((c) => <a href={c.url} target="_blank" rel="me noopener" aria-label={c.name} title={c.name}><Icon name={c.icon} size={20} /></a>)}
      </div>
      <a class="menu-mail" href={`mailto:${CONTACT_ADDRESS}`}>{CONTACT_ADDRESS}</a>
    </div>
  </nav>
</header>

<script>
  import { mountBar, OPENING } from "../adapters/letter/bar";
  import { shortEnough } from "../domain/letter/prompts";
  import { ROTATION } from "../content/prompts";
  import { CONTACT_ADDRESS } from "../content/channels";
  // Only questions that fit the bar on one line: about 46 characters on wide screens, 36 on phones.
  const max = matchMedia("(min-width: 700px)").matches ? 46 : 36;
  mountBar(document.querySelector<HTMLElement>("[data-bar-letter]")!, [OPENING, ...shortEnough(ROTATION, max)], CONTACT_ADDRESS);
  import { mountMenu } from "../adapters/menu/menu";
  mountMenu(document.querySelector<HTMLElement>("header.bar")!);
</script>

<style>
  /* Over the range the bar is bare, its words on their own paper; past the range it docks on paper. */
  .bar {
    position: fixed; inset: 0 0 auto; z-index: 10; background: transparent; transition: background-color .35s var(--ease);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; row-gap: 14px; padding: 18px var(--gutter);
  }
  .bar:global([data-docked]) { background: var(--paper); }
  .mark { font-size: 14px; line-height: 1.6; font-weight: 500; letter-spacing: .26em; text-transform: uppercase; white-space: nowrap; width: fit-content; }
  .mark a { text-decoration: none; }
  .mark, .ask, .sections a, .panel { background: var(--paper); box-shadow: 0 0 0 4px var(--paper); }
  .letter { grid-column: 1 / -1; grid-row: 2; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .ask {
    align-self: flex-start; background: none; border: 0; padding: 0; cursor: pointer; text-align: left;
    font-size: 15px; line-height: 1.5; font-weight: 500; letter-spacing: .04em; color: var(--signal); min-height: 24px;
  }
  .ask::after { content: ""; display: inline-block; width: 2px; height: 1.05em; margin-left: 2px; transform: translateY(3px); background: var(--signal); animation: blink 1.1s steps(1) infinite; }
  .letter:global(.open) .ask { color: var(--ink); }
  .letter:global(.open) .ask::after { display: none; }
  .panel { display: flex; flex-direction: column; gap: 8px; }
  .panel[hidden] { display: none; }
  .said { font: italic 400 14px/1.5 var(--sans); color: var(--ink-2); white-space: pre-wrap; }
  textarea, input {
    width: 100%; border: 0; padding: 0; resize: none; background: transparent; color: var(--ink); outline: none;
    font: 400 16px/1.6 var(--sans);
  }
  input::placeholder { color: var(--mute); opacity: 1; }
  .row { display: flex; gap: 16px; align-items: center; font-size: 13px; color: var(--ink-2); }
  .key {
    display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 500; letter-spacing: .08em; min-width: 40px; min-height: 28px; padding: 2px 7px 1px; cursor: pointer; background: none; color: var(--mute);
    border: 1px solid currentColor; border-bottom-width: 2px; border-radius: 3px;
  }
  .panel:global(.ready) .key { color: var(--signal); }
  .quiet { background: none; border: 0; padding: 0; cursor: pointer; font-size: 13px; }
  .status { font-size: 13px; color: var(--ink-2); }
  .status:empty { display: none; }
  .sections { display: none; }
  /* The phone menu (ADR 0019): an icon in the bar's corner; the panel drops under the bar, the page still below it. */
  .menu-button { grid-column: 2; grid-row: 1; justify-self: end; width: 44px; height: 44px; margin: -12px -12px -12px 0;
    display: grid; place-items: center; background: none; border: 0; cursor: pointer; color: var(--ink); }
  .menu { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px; margin: 6px calc(-1 * var(--gutter)) -18px;
    padding: 20px var(--gutter) 22px; background: var(--paper); box-shadow: 0 24px 32px -24px rgb(12 12 11 / .35); }
  .menu[hidden] { display: none; }
  .menu ol { list-style: none; padding: 0; margin: 0; }
  .menu-sections { display: flex; flex-direction: column; gap: 12px; }
  .menu-sections > li > a { display: flex; gap: 14px; align-items: baseline; text-decoration: none; }
  .menu .n { font: 400 12px var(--mono); color: var(--mute); }
  .menu .name { font-size: 24px; line-height: 1.3; font-weight: 500; letter-spacing: -.01em; }
  .menu .act .name { color: var(--signal); letter-spacing: .02em; }
  .menu-interests { display: flex; flex-direction: column; margin-top: 6px !important; padding-left: 30px !important; }
  .menu-interests a { display: flex; gap: 12px; align-items: baseline; padding: 8px 0; font-size: 16px; text-decoration: none; }
  .menu-interests .n { font-weight: 500; font-size: 11px; color: var(--signal); }
  .menu-foot { display: flex; flex-direction: column; gap: 6px; padding-top: 16px; }
  .menu-channels { display: flex; gap: 4px; margin-left: -12px; }
  .menu-channels a { display: grid; place-items: center; width: 44px; height: 44px; color: var(--ink); }
  .menu-mail { font-size: 15px; font-weight: 500; color: var(--ink-2); }
  .bar:global([data-menu-open]) { background: var(--paper); }
  @keyframes blink { 50% { opacity: 0; } }
  @media (min-width: 700px) {
    .bar { grid-template-columns: minmax(0, 1fr) min(560px, 40vw) minmax(0, 1fr); padding: 24px clamp(24px, 3vw, 56px); align-items: start; }
    .mark { font-size: 16px; letter-spacing: .32em; }
    .letter { grid-column: 2; grid-row: 1; align-items: center; }
    .menu-button { grid-column: 3; }
    .letter:global(.open) { align-items: stretch; }
    .ask { align-self: center; }
    .letter:global(.open) .ask { align-self: flex-start; }
  }
  @media (min-width: 1080px) {
    .menu-button, .menu { display: none !important; }
    .sections { display: flex; justify-self: end; gap: 32px; font-size: 14px; letter-spacing: .14em; }
  }
  @media (prefers-reduced-motion: reduce) { .ask::after { animation: none; } }
</style>
