---
// Andre's paragraph about the site, opening the page below the range (.docs/copy/interest-lines.md).
import type { Copy } from "../content/copy/copy";
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<div class="intro">
  <p>{copy.site.summary} {copy.site.more}</p>
</div>

<style>
  .intro { padding: 96px var(--gutter) 0; }
  p { font-size: 20px; line-height: 32px; color: var(--ink-2); max-width: 34em; }
  @media (min-width: 900px) {
    .intro { width: var(--column); margin: 0 auto; padding: 120px 0 0; }
    p { font-size: 24px; line-height: 38px; }
  }
</style>
