---
// The write-to-me section's letter (ADR 0016): a prompt in view, a roomy field, then the address to reply to.
import Icon from "./Icon.astro";
import { CONTACT_ADDRESS } from "../content/channels";
import type { Copy } from "../content/copy/copy";
interface Props { copy: Copy }
const { copy } = Astro.props;
---
<div class="letter" data-section-letter>
  <p class="prompt" data-prompt aria-live="polite"></p>
  <p class="said" data-said hidden></p>
  <label class="sr-only" for="write-note">{copy.letter.message}</label>
  <div class="field">
    <span class="pipe" aria-hidden="true"></span>
    <textarea id="write-note" rows="4"></textarea>
  </div>
  <label class="sr-only" for="write-from">{copy.letter.email}</label>
  <input id="write-from" type="email" autocomplete="email" placeholder={copy.letter.emailPlaceholder} hidden />
  <div class="row">
    <button class="key" type="button" data-key><Icon name="enter" size={14} /><span>{copy.letter.enter}</span></button>
    <button class="quiet" type="button" data-back hidden>{copy.letter.edit}</button>
    <span class="or">{copy.letter.orWriteTo} <a href={`mailto:${CONTACT_ADDRESS}`}>{CONTACT_ADDRESS}</a></span>
  </div>
  <p class="status" role="status"></p>
</div>

<script>
  import { mountSection } from "../adapters/letter/section";
  import { readWords } from "../adapters/letter/words";
  import { CONTACT_ADDRESS } from "../content/channels";
  mountSection(document.querySelector<HTMLElement>("[data-section-letter]")!, readWords(), CONTACT_ADDRESS);
</script>

<style>
  .letter { display: flex; flex-direction: column; gap: 24px; max-width: 760px; }
  .prompt { min-height: 64px; font-size: 24px; line-height: 32px; font-weight: 500; letter-spacing: -.01em; transition: opacity .6s ease; }
  .prompt:global(.leaving) { opacity: 0; }
  .said { font: italic 400 20px/32px var(--sans); color: var(--ink-2); white-space: pre-wrap; }
  /* The whole field takes a click, and it grows with the letter instead of opening on a tall void. */
  .field { position: relative; cursor: text; }
  textarea, input {
    display: block; width: 100%; border: 0; padding: 0; resize: none; background: transparent; color: var(--ink);
    font: 400 20px/32px var(--sans); letter-spacing: .01em; outline: none;
  }
  textarea { padding-left: 14px; field-sizing: content; min-height: calc(4 * 32px); cursor: text; }
  input::placeholder { color: var(--mute); opacity: 1; }
  /* At rest the caret stands still, a mark that says "here"; once in, the browser's own caret blinks. */
  .pipe { position: absolute; left: 0; top: 4px; width: 2px; height: 24px; background: var(--signal); pointer-events: none; }
  .letter:global(.ready) .pipe, .field:focus-within .pipe { display: none; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; font-size: 14px; font-weight: 500; color: var(--ink-2); }
  .key {
    display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 500; letter-spacing: .08em; min-width: 44px; min-height: 32px; padding: 3px 8px 2px; cursor: pointer; background: none; color: var(--mute);
    border: 1px solid currentColor; border-bottom-width: 2px; border-radius: 3px;
  }
  .letter:global(.ready) .key { color: var(--signal); }
  .quiet { background: none; border: 0; padding: 0; cursor: pointer; }
  .or { font-weight: 400; color: var(--mute); }
  .or a { font-weight: 500; color: var(--ink); }
  .status { font-size: 14px; color: var(--ink-2); }
  .status:empty { display: none; }
  @media (min-width: 900px) {
    .prompt { min-height: 76px; font-size: 30px; line-height: 38px; }
    .said { font-size: 24px; line-height: 40px; }
    textarea, input { font-size: 24px; line-height: 40px; }
    textarea { min-height: calc(4 * 40px); }
    .pipe { top: 6px; height: 28px; }
  }
  @media (prefers-reduced-motion: reduce) { .prompt { transition: none; } }
</style>
