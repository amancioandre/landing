---
// The one long page (ADR 0009), in any of the hub's languages.
import Base from "../layouts/Base.astro";
import Bar from "./Bar.astro";
import Section from "./Section.astro";
import Footer from "./Footer.astro";
import Range from "./Range.astro";
import WriteLetter from "./WriteLetter.astro";
import LatestList from "./LatestList.astro";
import Intro from "./Intro.astro";
import NowCarousel from "./NowCarousel.astro";
import { copyIn } from "../content/copy";
import { stopsIn } from "../content/interests";
import { loadNow } from "../adapters/now/load";
import { showsNow } from "../domain/now/now";
import { sectionsOf } from "../domain/page/sections";
import type { Language } from "../domain/languages/languages";

interface Props { language: Language }
const { language } = Astro.props;
const copy = copyIn(language);
const stops = stopsIn(copy);
const items = await loadNow();
const sections = sectionsOf({ showsNow: showsNow(items) });
const number = (id: string) => sections.find((s) => s.id === id)?.number ?? "";
---
<Base title="André Amnc" language={language} copy={copy}>
  <Bar copy={copy} stops={stops} sections={sections} />
  <Range copy={copy} stops={stops} />
  <main>
    <Intro copy={copy} />
    <Section id="latest" number={number("latest")} label={copy.sections.latest}><LatestList copy={copy} language={language} /></Section>
    {number("now") && <Section id="now" number={number("now")} drop={16} label={copy.sections.now}><NowCarousel copy={copy} language={language} items={items} /></Section>}
    <Section id="write" number={number("write")} drop={14} label={copy.sections.write}><WriteLetter copy={copy} /></Section>
  </main>
  <Footer copy={copy} language={language} />
</Base>
