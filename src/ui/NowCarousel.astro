---
// The Now (canvas row 17, B; ADR 0027): what Andre tagged, read sideways, each card shaped by what it is.
// Every word on a card is the thing's own; only the kind's label and the way out are the page's.
import Icon from "./Icon.astro";
import type { Copy } from "../content/copy/copy";
import type { Item, Kind } from "../domain/now/now";
import type { Language } from "../domain/languages/languages";
import { fill } from "../domain/languages/fill";
interface Props { copy: Copy; language: Language; items: readonly Item[] }
const { copy, language, items } = Astro.props;

const pad = (i: number) => String(i).padStart(2, "0");
const longDate = (iso: string) => new Date(iso).toLocaleDateString(language.tag, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const SIGNS = ["youtube", "instagram", "substack", "linkedin", "github", "patreon"] as const;
const sign = (i: Item) => (i.kind === "note" ? "note" : i.kind === "story" && i.via === "obsidian" ? "story" : SIGNS.find((s) => s === i.via) ?? (i.kind === "story" ? "story" : "note"));
const way = (i: Item) => fill(copy.now.open[i.kind as Kind], { where: i.where });
---
<div class="now" data-now>
  <div class="head">
    <span class="count" data-count>{pad(1)} / {pad(items.length)}</span>
    <div class="arrows">
      <button type="button" data-prev aria-label={copy.now.previous}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
      <button type="button" data-next aria-label={copy.now.next}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
    </div>
  </div>

  <div class="strip" data-strip tabindex="0" role="group" aria-roledescription={copy.carousel.carouselRole} aria-label={copy.now.strip}>
    {items.map((item, i) => (
      <article class={`card ${item.kind}`} data-now-card data-kind={item.kind} aria-roledescription={copy.carousel.slideRole}
        aria-label={fill(copy.now.slide, { n: i + 1, total: items.length, kind: copy.now.kinds[item.kind] })}>
        <div class="kind"><Icon name={sign(item)} size={16} /><span data-kind-label>{copy.now.kinds[item.kind]}</span><span class="where">{item.where}</span></div>
        {item.title && <h3>{item.title}</h3>}
        {item.words && <p class="words" data-words>{item.words}</p>}
        <div class="foot">
          <time datetime={item.date}>{longDate(item.date)}</time>
          {item.url && <a href={item.url} target="_blank" rel="noopener">{way(item)}<Icon name="out" size={13} class="out" /></a>}
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  import { mountNow } from "../adapters/now/now-view";
  mountNow(document.querySelector<HTMLElement>("[data-now]")!);
</script>

<style>
  .now { display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; align-items: center; gap: 16px; }
  .count { margin-left: auto; font: 400 12px var(--mono); color: var(--mute); }
  .arrows { display: flex; gap: 8px; }
  .arrows button { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 1px solid var(--mark); border-radius: 50%; cursor: pointer; color: var(--ink); }
  .arrows button:disabled { opacity: .35; cursor: default; }
  /* The strip runs to the screen's right edge; the spacer at its end lets the last card come to the column's edge too. */
  .strip { --gap: 32px; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; outline-offset: 8px;
    margin-right: calc(-1 * var(--gutter)); padding-bottom: 4px; }
  .strip::-webkit-scrollbar { display: none; }
  /* On phones one card shows at a time, so it keeps its own height; wider, the cards share a floor and their dates line up. */
  @media (max-width: 699px) { .strip { align-items: flex-start; } }
  .strip::after { content: ""; flex: none; width: max(0px, calc(100% - 420px)); }
  /* Each kind keeps its own width (layout B): a note is short, a story has room to open. */
  .card { flex: none; scroll-snap-align: start; width: min(var(--w), calc(100vw - 2 * var(--gutter) - 24px)); display: flex; flex-direction: column; gap: 14px;
  }
  .note { --w: 300px; } .post { --w: 300px; } .code { --w: 320px; } .story { --w: 380px; }
  .kind { display: flex; align-items: center; gap: 8px; color: var(--ink-2); font: 500 11px var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .where { margin-left: auto; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--mute); }
  h3 { font-size: 26px; line-height: 32px; font-weight: 500; letter-spacing: -.01em; }
  .code h3 { font: 500 20px/28px var(--mono); letter-spacing: 0; }
  .words { color: var(--ink-2); }
  .note .words { font-size: 20px; line-height: 1.45; color: var(--ink); }
  .note h3 + .words { font-size: inherit; line-height: inherit; color: var(--ink-2); }
  .post .words { font-size: 17px; line-height: 1.5; color: var(--ink); }
  .foot { margin-top: auto; padding-top: 4px; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  time { font: 400 12px var(--mono); color: var(--mute); }
  .foot a { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; }
  /* The way out waits in grey and turns red only when pointed at: red stays a single signal. */
  .foot :global(.out) { color: var(--mute); transition: color .2s ease; }
  .foot a:hover :global(.out), .foot a:focus-visible :global(.out) { color: var(--signal); }
  @media (min-width: 900px) { .strip { --gap: 40px; margin-right: calc(-1 * (100vw - 100%) / 2); } }
</style>
